# ─────────────────────────────────────────────────────────────────────────
# web-host-bot configuration
# Copy to `.env` and fill in. Anything left blank puts that integration into
# DRY-RUN/mock mode (so you can test the whole pipeline before wiring secrets).
# ─────────────────────────────────────────────────────────────────────────

# ---- Run controls ----
DAILY_LIMIT=10            # how many businesses to process per run
DRY_RUN=false             # true = never call live APIs; write artifacts to bot/_dryrun/
ENRICH=true               # true = fetch each business's existing site for grounding copy
PUBLIC_BASE_URL=https://demos.yourdomain.com   # base for the generated demo links

# ---- Google Sheet ----
SHEET_ID=16ji6lTjhpsud4gQdVCD_UrJKqoWY4O13zt90Uv3ts3c
SHEET_TAB=Sheet1          # the worksheet/tab name (or gid via SHEET_GID)
SHEET_GID=0
# Service account with EDIT access to the sheet. Either point at a file…
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# …or paste the JSON inline (takes precedence if set):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- Claude (content generation) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8        # use claude-haiku-4-5 for cheaper bulk runs

# ---- web_host (deploy target + review queue API) ----
HOST_BASE_URL=https://demos.yourdomain.com    # where the web_host server lives
HOST_ADMIN_PASSWORD=                          # the admin password (to mint a session)
TEMPLATE_SLUG=crystal-clear-glass             # slug of the master template the tenants clone

# ---- Email signature (the bot only DRAFTS emails; the SERVER sends them) ----
# Sending + the compliance footer live in the web_host server's .env now
# (RESEND_API_KEY etc.). These two just personalise the drafted signature:
SENDER_NAME=Kavindu
SENDER_COMPANY=GroovyMark
