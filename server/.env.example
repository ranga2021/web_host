# Port for the admin API/UI server (nginx proxies /admin and /api here)
PORT=3001

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# bcrypt hash of the single admin password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# Absolute path where active demo builds are served from by nginx.
DEMOS_DIR=/var/www/demos

# Absolute path where disabled demos are parked (still on disk, not served).
DISABLED_DIR=/var/www/demos/.disabled

# Working directory for git clones and builds (scratch space).
WORK_DIR=/var/lib/web-host-tool/work

# Public base URL of the hosting tool (used to display demo links in the UI).
PUBLIC_BASE_URL=https://demos.yourdomain.com

# Path to the SQLite database file.
DB_PATH=/var/lib/web-host-tool/data.db

# Max concurrent builds.
BUILD_CONCURRENCY=1

# ─── Email (outreach send on approval + admin notifications) ───────────────
# Optional: with no RESEND_API_KEY the dashboard still works (approving marks
# items sent but logs instead of emailing). Set these to send for real.
RESEND_API_KEY=
EMAIL_FROM=Kavindu <kavindu@groovymark.com>
EMAIL_REPLY_TO=kavindu@groovymark.com
SENDER_NAME=Kavindu
SENDER_COMPANY=GroovyMark
# Required for Australian Spam Act compliance (physical address + opt-out):
SENDER_ADDRESS=GroovyMark, Sydney NSW, Australia
UNSUBSCRIBE_URL=https://groovymark.com/unsubscribe
# Where admin notification emails go (defaults to EMAIL_REPLY_TO):
ADMIN_EMAIL=kavindu@groovymark.com

# ─── Lead collection (the dashboard "Collect leads" button) ────────────────
# Google Places API key. Optional, but strongly recommended: without it the
# collector falls back to the Yellow Pages scraper, which Google/YP frequently
# rate-limit (returns 0). With a key, the button reliably returns businesses.
# Get one: Google Cloud Console → enable "Places API (New)" → add billing →
# create an API key → restrict it to the Places API. (Google gives a recurring
# monthly free credit that covers low-volume prospecting.)
PLACES_API_KEY=

# ─── Google Sheet import (the dashboard "Import from Google Sheet" button) ──
# Reads the sheet's PUBLIC CSV export — no credentials needed as long as the
# sheet is shared "Anyone with the link can view". SHEET_GID is the tab's gid
# (the number after gid= in the sheet URL; the first tab is 0).
SHEET_ID=16ji6lTjhpsud4gQdVCD_UrJKqoWY4O13zt90Uv3ts3c
SHEET_GID=0

# ─── Automatic demo generation (the Leads "⚡ Create demo" button) ──────────
# Optional. With a key, each demo's copy is written by Claude, grounded on the
# business's own website. Without a key the button still works — it falls back
# to a deterministic template populated from the lead's details.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
